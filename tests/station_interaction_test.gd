extends "res://tests/stations_test.gd"

func panel_fits() -> void:
	await frames(5)
	verify(Rect2(Vector2.ZERO,game.hud.root.size).encloses(game.hud.modal.get_global_rect()),"Painel fica dentro do viewport")

func run() -> void:
	StationJourney.persistence_enabled = false
	StationJourney.reset()
	await open_station("water")
	verify(not game.hud.diagnostic_panel.visible,"HUD físico não mostra diagnóstico digital")
	var record: Dictionary = game.perspectives.physical_materials[0]
	var original: Material = record.node.material_override
	await mode(true)
	verify(record.node.material_override!=original,"GAIA substitui materiais em vez de aplicar filtro de tela")
	verify(game.hud.diagnostic_panel.visible and game.markers.route.visible,"Terminais e diagnóstico exclusivos da camada digital")
	verify(game.perspectives.digital_audio.stream!=null,"Ambiente digital possui áudio em loop configurado")
	game.hud.show_system_panel("water_route")
	await panel_fits()
	game.hud.modal_box.get_child(3).pressed.emit()
	verify(StationJourney.value("water_route")==1 and not game.hud.modal_open,"Botão B configura o circuito certo e fecha o painel")
	await mode(false)
	verify(record.node.material_override==original and not game.markers.route.visible,"Retorno ao físico recompõe material e oculta circuitos")
	verify(game.perspectives.physical_audio.stream!=null,"Ambiente físico possui áudio diferente configurado")
	game.set_muted(true)
	verify(AudioServer.is_bus_mute(AudioServer.get_bus_index("Master")),"Silenciar afeta as duas perspectivas pelo Master")
	await open_station("soil")
	await mode(true)
	game.hud.show_system_panel("soil_capsules")
	await panel_fits()
	var grid: GridContainer = game.hud.modal_box.get_child(2)
	grid.get_child(1).pressed.emit()
	grid.get_child(3).pressed.emit()
	game.hud.modal_box.get_child(3).pressed.emit()
	verify(StationJourney.value("soil_mask")==10,"Botões B e D constroem a seleção biológica")
	game.hud.show_system_panel("soil_temperature")
	await panel_fits()
	game.hud.modal_box.get_child(3).pressed.emit()
	verify(StationJourney.value("soil_temperature")==1,"Botão 24°C configura termostato correto")
	game.system.interact("filter")
	game.system.interact("install")
	game.system.interact("humidity")
	verify(game.system.interact("authorize").ok,"Autorização biológica com parâmetros corretos")
	game.configure_system("soil_capsules",1)
	verify(StationJourney.value("soil_authorized")==0,"Modificar seleção invalida autorização antiga")
	verify(not game.system.interact("irrigate").ok,"Irrigação não usa validação obsoleta")
	game.configure_system("soil_capsules",10)
	game.system.interact("authorize")
	game.system.interact("irrigate")
	verify(not game.system.configure("soil_temperature",2).ok,"Germinação iniciada protege configuração segura")
	await open_station("air")
	game.system.interact("module")
	game.system.interact("install")
	game.hud.show_technician()
	await panel_fits()
	game.hud.modal_box.get_child(3).pressed.emit()
	verify(StationJourney.value("air_team")==1,"Segunda resposta da técnica mantém cooperação")
	await move_to(8)
	for height in [2.6,5.2,7.8,0.0]:
		verify(game.operate_lift(),"Elevador inicia viagem Atmos para %.1f"%height)
		await frames(300 if height==0 else 140)
		verify(absf(game.player.position.y-height)<0.2,"Corpo chega ao piso Atmos %.1f sem colisão com as passarelas"%height)
	await move_to(2)
	await mode(true)
	game.system.interact("scan")
	game.system.interact("coarse")
	game._refresh()
	verify(not game.interact_object("turbine"),"Comando fora da ordem bloqueado na camada digital")
	verify(StationJourney.value("air_sequence")==0,"Erro após progresso reinicia sequência de verdade")
	verify(is_zero_approx(game.environment.duct_shutters[0].rotation.y),"Reinício recompõe também o duto visual")
	verify(StationJourney.value("air_module")==2 and StationJourney.value("air_team")==1,"Erro não perde módulo nem cooperação")
	for command in ["coarse","carbon","turbine"]:verify(game.system.interact(command).ok,"Recuperação sem softlock: "+command)
	game.hud.show_decision()
	await panel_fits()
	verify(game.hud.modal_box.get_child(2).has_focus(),"Decisão recebe foco para navegação por teclado")
	game.queue_free()
	await frames(6)
	OS.delay_msec(100)
	print("INTERFACE + RECUPERAÇÃO GAIA: %d verificações, %d falhas"%[assertions,failures])
	get_tree().quit(0 if failures==0 else 1)
