extends "res://tests/test_fixture.gd"

func open_region(region_id: String, stage_id: String) -> void:
	if is_instance_valid(game):
		game.queue_free()
		await frames(3)
	StationJourney.stage = stage_id
	game = load(StationJourney.SCENES[region_id]).instantiate()
	add_child(game)
	await frames(14)
	game.hud.touch.persistence_enabled = false
	game.hud.touch.set_manual_mode(2)
	if game.hud.modal_open:game.hud.close_modal()

func run() -> void:
	StationJourney.persistence_enabled = false
	StationJourney.reset()
	SceneRouter.test_mode = true
	AudioDirector.persistence_enabled = false
	await open_region("nova_eden","nova")
	verify(game.player.sprite.sprite_frames.get_frame_count("walk")==12,"Caminhada real possui 12 quadros")
	verify(game.player.sprite.sprite_frames.get_frame_count("idle")==8,"Idle original preservado")
	verify(FileAccess.get_sha256("res://assets/processados/protagonista_provisorio/personagem.png")=="2821565f4fa6810c1cfdb32166fd175b72a3af5a02e34d8e55accba2b1c1f94b","Arte anterior não foi alterada")
	var atlas: Texture2D = game.player.sprite.sprite_frames.get_frame_texture("walk",0)
	verify(atlas.get_image().get_pixel(0,0).a==0,"Fundo claro conectado removido")
	await move_to(4)
	await use_near("lyra")
	verify(not game.objects.has("module") and game.objects.has("armory"),"Fuga tem arsenal, não cadeia de baterias")
	await defeat_nova(game)
	await frames(80)
	verify(game.environment.gate.collision_layer==0 and game.environment.gate_visual.position.y>3,"Derrotar o esquadrão abre a saída visivelmente")
	await move_to(34.5)
	verify(not game.finished,"Fuga permite sair após o combate")
	StationJourney.reset()
	await open_region("nova_eden","nova")
	for hit_index in range(6):
		game.combat.invulnerable = 0
		game.combat.take_hit()
	await frames(55)
	verify(game.finished and game.hud.modal_open,"Vida esgotada apresenta derrota")
	verify(absf(game.player.sprite.rotation.z)>0.5,"Derrota anima queda do personagem")
	verify(game.hud.modal_box.get_child(2) is Button and game.hud.modal_box.get_child(3) is Button,"Derrota oferece reinício ou retomada")
	await open_region("laboratory","intro")
	await move_to(8)
	await use_near("terminal")
	game.toggle_gaia()
	await move_to(11)
	await climb_to(2.6)
	await move_to(14.8)
	await use_near("scan")
	game.toggle_gaia()
	await move_to(18.4)
	await use_near("maintenance")
	await move_to(11)
	await climb_to(0)
	await move_to(13.3)
	await climb_to(-2.7)
	await move_to(17)
	await use_near("cell")
	await move_to(13.3)
	await climb_to(0)
	await move_to(21.7)
	await use_near("socket")
	await move_to(25.7)
	game.toggle_gaia()
	await use_near("authorize")
	game.toggle_gaia()
	await move_to(27)
	await use_near("gate")
	await move_to(32)
	await use_near("exit")
	verify(StationJourney.stage=="stations","Percurso físico completo do laboratório alcança as estações")
	await open_region("boss","boss")
	verify(game.environment.get_script().resource_path=="res://scripts/environments/departure_environment.gd","Confronto acontece na doca terrestre, não no laboratório")
	verify(not game.interact_object("shutdown"),"Bloqueio final exige os circuitos anteriores")
	await defeat_departure(game)
	game.safe_time = 0
	game.hazard_time = 2.99
	game.player.position = Vector3(8,0.05,0)
	await frames(2)
	verify(game.hits==1,"Pulso tem colisão de contenção")
	game.safe_time = 0
	game.hazard_time = 3.1
	game.player.position = Vector3(8,1.8,0)
	game.player.velocity = Vector3.ZERO
	await frames(2)
	verify(game.hits==1,"Salto acima do pulso evita contenção")
	game.player.position = Vector3(5,0.05,0)
	game.hazard_time = 4.3
	game.toggle_gaia()
	verify(game.interact_object("breaker"),"Implante local diagnostica a trava sem autorização de GAIA")
	game.hud.close_modal()
	game.toggle_gaia()
	verify(game.interact_object("breaker"),"Corpo desliga a trava")
	game.toggle_gaia()
	verify(game.interact_object("redirect"),"Interface local redireciona energia")
	game.toggle_gaia()
	verify(game.interact_object("shutdown"),"Corpo desliga o bloqueio")
	await frames(2)
	verify(StationJourney.value("boss_mask")==7 and not game.hazard.visible,"Segurança desativada cessa os pulsos")
	await frames(80)
	verify(game.environment.gate.collision_layer==0,"Superar a contenção abre o portão de embarque")
	game.queue_free()
	await frames(5)
	print("MOVIMENTO / FUGA / CONFRONTO: %d verificações, %d falhas"%[assertions,failures])
	if failures>0:get_tree().quit(1)
	else:await AudioDirector.quit_game()
