extends "res://tests/journey_test.gd"

func run() -> void:
	AudioDirector.persistence_enabled = false
	StationJourney.persistence_enabled = false
	await open_demo()
	var moment: Vector3 = game.player.position
	var objective_before: String = game.current_objective()
	verify(game.interact_object("nara"),"Carta da equipe pode ser consultada")
	verify(game.hud.viewing_memory,"Registro antigo usa contexto de passado")
	verify(game.hud.modal_box.get_child(0).text.begins_with("PASSADO"),"Passado identificado no título")
	verify("Nada aqui muda o passado" in game.hud.modal_box.get_child(1).text,"Arquivo explica que não modifica a época")
	await frames(3)
	verify(game.player.position.is_equal_approx(moment),"Consultar o passado não move o protagonista")
	game.hud.close_modal()
	verify(not game.hud.viewing_memory and not game.perspectives.memory.visible,"Fechar arquivo remove a reconstrução")
	verify(game.current_objective()==objective_before,"Arquivo não resolve o puzzle atual")
	verify("PRESENTE" in game.hud.toast.text,"Retorno ao presente é explícito")
	verify(game.interact_object("terminal"),"GAIA fala no presente")
	verify(not game.hud.viewing_memory and game.hud.modal_box.get_child(0).text.begins_with("PRESENTE"),"Diálogo ao vivo não vira arquivo antigo")
	game.hud.close_modal()
	verify(game.toggle_gaia(),"Análise digital disponível")
	verify(StationJourney.stage=="intro" and game.player.position.is_equal_approx(moment),"Q muda a perspectiva, não a época ou região")
	game.hud.show_timeline()
	var explanation: String = game.hud.modal_box.get_child(1).text
	for epoch in ["PASSADO","PRESENTE","FUTURO"]:verify(epoch in explanation,"Guia explica "+epoch)
	verify("não viaja no tempo" in explanation and "não muda a época" in explanation,"Guia distingue arquivos de viagem no tempo")
	game.hud.close_modal()
	game.hud.show_pause()
	await frames(4)
	for control in game.hud.modal_box.get_child(2).get_children():verify(control.size.x>=100,"Botão de navegação da pausa tem largura legível")
	for control in game.hud.modal_box.get_child(4).get_children():verify(control.size.x>=100,"Botão de configuração da pausa tem largura legível")
	game.hud.close_modal()
	game.queue_free()
	await frames(3)
	StationJourney.reset()
	for region_id in StationJourney.ORDER:seed_station(region_id)
	await open_station("nexus")
	verify(game.interact_object("voss"),"Voss conversa ao vivo no porto")
	verify(not game.hud.viewing_memory and not game.perspectives.memory.visible,"Conversa atual de Voss não gera holograma histórico")
	game.hud.close_modal()
	await mode(true)
	verify(game.interact_object("scan"),"Diagnóstico atual de NEXUS acessível")
	verify(not game.hud.viewing_memory and game.hud.modal_box.get_child(0).text.begins_with("PRESENTE"),"Diagnóstico de agora não é apresentado como passado")
	game.hud.close_modal()
	game.hud.show_final()
	verify(game.hud.modal_box.get_child(0).text.begins_with("FUTURO"),"Escolha apresenta possibilidades futuras")
	verify("não profecias" in game.hud.modal_box.get_child(1).text,"Futuro não é apresentado como previsão garantida")
	game.hud.close_modal()
	var timeline: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/story/timeline.json"))
	for region_id in StationJourney.ORDER:verify(int(str(timeline.records[region_id]).left(4))<2187,"Arquivo datado antes do presente / "+region_id)
	var introduction: Array = JSON.parse_string(FileAccess.get_file_as_string("res://data/story/intro.json"))
	verify(introduction[0].title.begins_with("PASSADO") and introduction[2].title.begins_with("PRESENTE") and introduction[5].title.begins_with("FUTURO"),"Introdução organiza três momentos")
	var endings: Dictionary = JSON.parse_string(FileAccess.get_file_as_string("res://data/story/cinematics.json"))
	verify("GAIA" in endings.earth[0].text and "ajudar" in endings.earth[0].text,"GAIA apoia a restauração")
	verify("GAIA permanece na Terra" in endings.mars[0].text,"GAIA não acompanha nem orienta a fuga")
	verify(endings.mars[4].title.begins_with("MESES DEPOIS"),"Travessia não parece instantânea")
	game.queue_free()
	await frames(3)
	StationJourney.stage = "ending"
	StationJourney.put("final_destination",2)
	StationJourney.put("legacy_departure",1)
	game = load("res://scenes/regions/epilogue.tscn").instantiate()
	add_child(game)
	await frames(3)
	verify(game.title.text==endings.legacy_mars_opening.title,"Final legado usa abertura de compatibilidade")
	verify("progresso anterior" in game.subtitle.text and "confronto" not in game.subtitle.text,"Final concluído não inventa confronto retroativo")
	game.queue_free()
	await frames(5)
	print("NARRATIVA / LINHA DO TEMPO: %d verificações, %d falhas"%[assertions,failures])
	if failures>0:get_tree().quit(1)
	else:await AudioDirector.quit_game()
