func run() -> void:
	StationJourney.persistence_enabled = false
	StationJourney.reset()
	await water_route()
	await soil_route()
	await air_route()
	game.audio.stop()
	game.queue_free()
	await frames(4)
	OS.delay_msec(80)
	print("ESTAÇÕES 2.5D: %d verificações, %d falhas"%[assertions,failures])
	if OS.has_feature("stations_qa"):
		var canvas := CanvasLayer.new()
		add_child(canvas)
		var result := SignalTheme.label("ESTAÇÕES WEB / QA CONCLUÍDO\n\n%d verificações · %d falhas\n\nCapibaribe + Banco Verde + Atmos\nPercurso real / escadas / elevador / perspectivas\nWebGL 2 / testes automatizados, não celular físico"%[assertions,failures],24,SignalTheme.TEAL)
		result.position = Vector2(50,100)
		canvas.add_child(result)
	else:get_tree().quit(0 if failures==0 else 1)
