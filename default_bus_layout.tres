[gd_resource type="AudioBusLayout" load_steps=6 format=3]

[sub_resource type="AudioEffectLimiter" id="Limiter"]
ceiling_db = -1.0
threshold_db = -3.0

[sub_resource type="AudioEffectLowPassFilter" id="AmbientFilter"]
cutoff_hz = 16000.0

[sub_resource type="AudioEffectReverb" id="AmbientRoom"]
room_size = 0.6
wet = 0.08
dry = 1.0

[sub_resource type="AudioEffectLowPassFilter" id="EffectsFilter"]
cutoff_hz = 18000.0

[sub_resource type="AudioEffectReverb" id="EffectsRoom"]
room_size = 0.55
wet = 0.1
dry = 1.0

[resource]
bus/0/name = &"Master"
bus/0/effect/0/effect = SubResource("Limiter")
bus/0/effect/0/enabled = true
bus/1/name = &"Music"
bus/1/send = &"Master"
bus/2/name = &"Ambience"
bus/2/send = &"Master"
bus/2/effect/0/effect = SubResource("AmbientFilter")
bus/2/effect/0/enabled = true
bus/2/effect/1/effect = SubResource("AmbientRoom")
bus/2/effect/1/enabled = true
bus/3/name = &"SFX"
bus/3/send = &"Master"
bus/3/effect/0/effect = SubResource("EffectsFilter")
bus/3/effect/0/enabled = true
bus/3/effect/1/effect = SubResource("EffectsRoom")
bus/3/effect/1/enabled = true
bus/4/name = &"UI"
bus/4/send = &"Master"
bus/5/name = &"Voice"
bus/5/send = &"Master"
